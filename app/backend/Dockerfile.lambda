# syntax=docker/dockerfile:1
# Lambda container (Function URL). Build context: app/ (sibling of backend/ and model/).
#   docker build --platform linux/amd64 --provenance=false --sbom=false \
#     -f backend/Dockerfile.lambda -t api:lambda .

FROM public.ecr.aws/lambda/python:3.13

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /usr/local/bin/uv

WORKDIR ${LAMBDA_TASK_ROOT}

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv export --frozen --no-dev --no-hashes --no-emit-project -o /tmp/requirements.txt \
    && uv pip install --system --no-cache -r /tmp/requirements.txt

COPY backend/handler.py ${LAMBDA_TASK_ROOT}/handler.py
COPY backend/app ${LAMBDA_TASK_ROOT}/app
COPY model ${LAMBDA_TASK_ROOT}/model

# Operating threshold lives next to the .pkl (stem + _meta.json).
ENV MODEL_PATH=${LAMBDA_TASK_ROOT}/model/modelo_riesgo_hospitalizacion_v1.pkl \
    MODEL_META_PATH=${LAMBDA_TASK_ROOT}/model/modelo_riesgo_hospitalizacion_v1_meta.json

CMD ["handler.handler"]
