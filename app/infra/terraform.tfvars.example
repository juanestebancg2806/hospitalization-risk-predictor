aws_region         = "us-east-1"
project            = "hospitalization-risk"
environment        = "prod"
lambda_memory_mb   = 1024
log_retention_days = 14

# Apply #1: leave empty (ECR + SPA only, no Lambda).
lambda_image_uri = ""

# Apply #2: after docker push, set the URI (example):
# lambda_image_uri = "123456789012.dkr.ecr.us-east-1.amazonaws.com/hospitalization-risk-prod-api:v1"
